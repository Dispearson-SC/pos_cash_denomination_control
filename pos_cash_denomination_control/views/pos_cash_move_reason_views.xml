<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_cash_move_reason_list" model="ir.ui.view">
        <field name="name">pos.cash.move.reason.list</field>
        <field name="model">pos.cash.move.reason</field>
        <field name="arch" type="xml">
            <list string="Cash Move Reasons">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="direction"/>
                <field name="is_vault"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_pos_cash_move_reason_form" model="ir.ui.view">
        <field name="name">pos.cash.move.reason.form</field>
        <field name="model">pos.cash.move.reason</field>
        <field name="arch" type="xml">
            <form string="Cash Move Reason">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="direction"/>
                        <field name="is_vault"/>
                        <field name="sequence"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pos_cash_move_reason_search" model="ir.ui.view">
        <field name="name">pos.cash.move.reason.search</field>
        <field name="model">pos.cash.move.reason</field>
        <field name="arch" type="xml">
            <search string="Cash Move Reasons">
                <field name="name"/>
                <filter string="Vault" name="is_vault" domain="[('is_vault', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_pos_cash_move_reason" model="ir.actions.act_window">
        <field name="name">Cash Move Reasons</field>
        <field name="res_model">pos.cash.move.reason</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
