<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Backs specs/cash-count-records/spec.md "Statement Lines Filterable
         And Groupable By Reason". Own views instead of inheriting `account`
         views (design.md Views and menus): `account`'s view xmlids are not
         in the sparse clone and Enterprise may change them. -->
    <record id="view_pos_cash_move_statement_line_list" model="ir.ui.view">
        <field name="name">account.bank.statement.line.pos.cash.move.list</field>
        <field name="model">account.bank.statement.line</field>
        <field name="arch" type="xml">
            <list string="POS Cash Moves">
                <field name="date"/>
                <field name="pos_session_id"/>
                <field name="cash_move_reason_id"/>
                <field name="payment_ref"/>
                <field name="amount" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_pos_cash_move_statement_line_search" model="ir.ui.view">
        <field name="name">account.bank.statement.line.pos.cash.move.search</field>
        <field name="model">account.bank.statement.line</field>
        <field name="arch" type="xml">
            <search string="POS Cash Moves">
                <field name="pos_session_id"/>
                <field name="cash_move_reason_id"/>
                <filter name="filter_date" date="date"/>
                <group>
                    <filter string="Reason" name="group_by_reason" context="{'group_by':'cash_move_reason_id'}"/>
                    <filter string="Session" name="group_by_session" context="{'group_by':'pos_session_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pos_cash_move_statement_line" model="ir.actions.act_window">
        <field name="name">POS Cash Moves</field>
        <field name="res_model">account.bank.statement.line</field>
        <field name="view_mode">list</field>
        <field name="domain">[('pos_session_id', '!=', False)]</field>
        <field name="context">{'search_default_group_by_reason': 1}</field>
        <field name="search_view_id" ref="view_pos_cash_move_statement_line_search"/>
    </record>
</odoo>
