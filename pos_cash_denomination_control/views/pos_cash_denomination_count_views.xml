<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Backs specs/cash-count-records/spec.md "Reporting Views, Menu,
         Access, And Record Rules": list, pivot, and graph views on count
         lines, including a reason dimension, grouped by POS, date, move
         type, denomination, reason, and employee. -->
    <record id="view_pos_cash_denomination_count_line_list" model="ir.ui.view">
        <field name="name">pos.cash.denomination.count.line.list</field>
        <field name="model">pos.cash.denomination.count.line</field>
        <field name="arch" type="xml">
            <list string="Denomination Counts">
                <field name="date"/>
                <field name="config_id"/>
                <field name="move_type"/>
                <field name="bill_name"/>
                <field name="bill_value"/>
                <field name="quantity"/>
                <field name="subtotal" sum="Total"/>
                <field name="reason_id"/>
                <field name="employee_name" optional="show"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_pos_cash_denomination_count_line_pivot" model="ir.ui.view">
        <field name="name">pos.cash.denomination.count.line.pivot</field>
        <field name="model">pos.cash.denomination.count.line</field>
        <field name="arch" type="xml">
            <pivot string="Denomination Counts Analysis" sample="1">
                <field name="config_id" type="row"/>
                <field name="move_type" type="row"/>
                <field name="reason_id" type="row"/>
                <field name="bill_value" type="col"/>
                <field name="quantity" type="measure"/>
                <field name="subtotal" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_pos_cash_denomination_count_line_graph" model="ir.ui.view">
        <field name="name">pos.cash.denomination.count.line.graph</field>
        <field name="model">pos.cash.denomination.count.line</field>
        <field name="arch" type="xml">
            <graph string="Denomination Counts Analysis" sample="1">
                <field name="bill_value"/>
                <field name="subtotal" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_pos_cash_denomination_count_line_search" model="ir.ui.view">
        <field name="name">pos.cash.denomination.count.line.search</field>
        <field name="model">pos.cash.denomination.count.line</field>
        <field name="arch" type="xml">
            <search string="Denomination Counts">
                <field name="config_id"/>
                <field name="reason_id"/>
                <field name="bill_id"/>
                <filter name="filter_date" date="date"/>
                <group>
                    <filter string="Point of Sale" name="group_by_config" context="{'group_by':'config_id'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by':'date:day'}"/>
                    <filter string="Move Type" name="group_by_move_type" context="{'group_by':'move_type'}"/>
                    <filter string="Denomination" name="group_by_bill" context="{'group_by':'bill_id'}"/>
                    <filter string="Reason" name="group_by_reason" context="{'group_by':'reason_id'}"/>
                    <filter string="Employee" name="group_by_employee" context="{'group_by':'employee_name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pos_cash_denomination_count_line" model="ir.actions.act_window">
        <field name="name">Denomination Counts</field>
        <field name="res_model">pos.cash.denomination.count.line</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_pos_cash_denomination_count_line_search"/>
        <field name="context">{'search_default_group_by_config': 1}</field>
    </record>
</odoo>
