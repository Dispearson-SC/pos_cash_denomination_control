<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_cash_denomination_control.CashMovePopup" t-inherit="point_of_sale.CashMovePopup" t-inherit-mode="extension">
        <xpath expr="//button[contains(@t-on-click, &quot;'in'&quot;)]" position="attributes">
            <attribute name="t-if">pos.config.allow_cash_in</attribute>
        </xpath>
        <xpath expr="//div[hasclass('input-amount')]//Input" position="attributes">
            <attribute name="readonly">ui.isSmall or pcdcCountRequired</attribute>
        </xpath>
        <!-- Sibling of the amount wrapper inside the flex row, so it renders to the left of the field. -->
        <xpath expr="//div[hasclass('input-amount')]//Input/.." position="before">
            <div t-if="pcdcCountRequired" class="pcdc-breakdown-button button icon btn btn-secondary btn-lg lh-lg" t-on-click="openNumpadDialog">
                <i class="fa fa-money" role="img" title="Open the denomination breakdown popup"/>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('form-floating')]" position="before">
            <div class="pcdc-reason-select-wrapper mb-2">
                <select class="form-select pcdc-reason-select"
                    t-on-change="onReasonChange">
                    <option value="">-- Select a reason --</option>
                    <t t-foreach="availableReasons" t-as="reason" t-key="reason.id">
                        <option t-att-value="reason.id" t-att-selected="reason.id === state.reasonId">
                            <t t-esc="reason.name"/>
                        </option>
                    </t>
                </select>
            </div>
        </xpath>
        <xpath expr="//textarea[@name='reason']" position="attributes">
            <attribute name="t-model">state.note</attribute>
        </xpath>
        <xpath expr="//label[@for='reason']" position="replace">
            <label for="reason">Note (optional)</label>
        </xpath>
    </t>
</templates>
