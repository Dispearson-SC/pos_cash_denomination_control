<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos_cash_denomination_control</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_payment_section']" position="after">
                <block title="Cash Control" id="pcdc_cash_section" invisible="not pos_cash_control">
                    <setting id="pcdc_allow_cash_in" string="Cash In"
                        help="Allow cash-in operations for this point of sale. Off by default.">
                        <field name="pos_allow_cash_in"/>
                    </setting>
                    <setting id="pcdc_vault_withdrawal_threshold" string="Vault Withdrawal Alert"
                        help="Non-blocking alert shown when the expected drawer cash reaches this amount. Zero disables the alert.">
                        <field name="pos_vault_withdrawal_threshold"/>
                    </setting>
                    <setting id="pcdc_vault_withdrawal_blocking" string="Vault Withdrawal Blocking"
                        help="Stop validating sales once the expected drawer cash reaches the vault withdrawal threshold, until a cash-out brings it back down. Has no effect while the threshold above is zero."
                        invisible="not pos_vault_withdrawal_threshold">
                        <field name="pos_vault_withdrawal_blocking"/>
                    </setting>
                    <setting id="pcdc_cash_count_opening_required" string="Opening Denomination Count"
                        help="Require a denomination breakdown when opening the session.">
                        <field name="pos_cash_count_opening_required"/>
                    </setting>
                    <setting id="pcdc_cash_count_out_required" string="Cash-Out Denomination Count"
                        help="Require a denomination breakdown for cash-out operations.">
                        <field name="pos_cash_count_out_required"/>
                    </setting>
                    <setting id="pcdc_cash_count_in_required" string="Cash-In Denomination Count"
                        help="Require a denomination breakdown for cash-in operations."
                        invisible="not pos_allow_cash_in">
                        <field name="pos_cash_count_in_required"/>
                    </setting>
                    <setting id="pcdc_cash_count_closing_required" string="Closing Denomination Count"
                        help="Require a denomination breakdown when closing the session.">
                        <field name="pos_cash_count_closing_required"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
